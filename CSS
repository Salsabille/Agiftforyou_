/* Layout: une colonne étroite, comme une boîte posée sur une table. Étapes en onglets, aperçu puis code d'envoi. */
:root{
  --paper:#eeeaf4; --card:#faf8fd; --ink:#2b2234; --muted:#6d6379; --line:#d9d2e4;
  --accent:#c93a73; --accent-ink:#ffffff; --thread:#2f7f78; --soft:#f3d9e4;
  --display:"Instrument Serif",Georgia,serif; --body:"Figtree",system-ui,sans-serif; --hand:"Caveat","Segoe Print",cursive;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){
  --paper:#1b1522; --card:#262030; --ink:#f1ebf7; --muted:#a79bb5; --line:#3a3248; --accent:#ec6a9a; --accent-ink:#1b1522; --thread:#5fc2b8; --soft:#3b2634; color-scheme:dark}}
:root[data-theme="dark"]{
  --paper:#1b1522; --card:#262030; --ink:#f1ebf7; --muted:#a79bb5; --line:#3a3248; --accent:#ec6a9a; --accent-ink:#1b1522; --thread:#5fc2b8; --soft:#3b2634; color-scheme:dark}
*{box-sizing:border-box}
[hidden]:not([hidden=until-found i]){display:none!important}
img{max-width:100%}
body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.55 var(--body);padding-inline:16px;padding-block:32px 64px}
main{max-width:640px;margin-inline:auto;display:flex;flex-direction:column;gap:24px}
h1{font:italic 400 clamp(2.4rem,9vw,3.6rem)/1 var(--display);margin:0;text-wrap:balance}
h2{font:400 1.7rem/1.1 var(--display);margin:0}
p{margin:0}
.eyebrow{font-size:.75rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.lead{color:var(--muted);max-width:52ch}
.modes{display:flex;gap:8px;flex-wrap:wrap}
button,input,textarea{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.btn{border:1px solid var(--ink);background:transparent;border-radius:999px;padding:10px 18px;font-weight:500}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.small{padding:6px 12px;font-size:.875rem}
.names{display:grid;grid-template-columns:1fr 1fr;gap:12px}
@media(max-width:420px){.names{grid-template-columns:1fr}}
label.f{display:flex;flex-direction:column;gap:4px;font-size:.8rem;color:var(--muted);min-width:0}
input[type=text],textarea{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:10px 12px;width:100%;color:var(--ink)}
.tabs{display:flex;gap:6px;flex-wrap:wrap}
.tab{border:1px solid var(--line);background:transparent;border-radius:999px;padding:7px 14px;font-size:.9rem;display:flex;gap:8px;align-items:center}
.tab[aria-selected=true]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.tab i{width:8px;height:8px;border-radius:50%;background:var(--line);display:inline-block}
.tab.done i{background:var(--thread)}
.panel{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:14px}
.hint{font-size:.875rem;color:var(--muted)}
.letter{font:600 1.5rem/32px var(--hand);min-height:288px;resize:vertical;border:0;border-radius:6px;padding:4px 14px;
  background:repeating-linear-gradient(to bottom,transparent 0 31px,var(--line) 31px 32px)}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.sw{width:28px;height:28px;border-radius:50%;border:2px solid var(--card);box-shadow:0 0 0 1px var(--line);padding:0}
.sw[aria-pressed=true]{box-shadow:0 0 0 2px var(--ink)}
canvas.draw{width:100%;max-width:320px;aspect-ratio:1;background:
  conic-gradient(var(--paper) 25%,var(--card) 0 50%,var(--paper) 0 75%,var(--card) 0) 0 0/20px 20px;border:1px solid var(--line);border-radius:12px;touch-action:none;cursor:crosshair}
.grid{display:grid;gap:2px;touch-action:none;user-select:none;width:100%;max-width:360px}
.grid.stitch{grid-template-columns:repeat(12,1fr)}
.grid.stitch b{aspect-ratio:1;background:var(--paper);border-radius:2px;position:relative;display:block}
.grid.stitch b.on::after{content:"×";position:absolute;inset:0;display:grid;place-items:center;color:#fff;font:600 1.1em/1 var(--body);text-shadow:0 0 1px #0004}
.grid.seq{grid-template-columns:repeat(8,1fr);gap:4px}
.grid.seq b{aspect-ratio:1;background:var(--paper);border:1px solid var(--line);border-radius:6px;display:block}
.grid.seq b.on{background:var(--accent);border-color:var(--accent)}
.grid.seq b.now{outline:2px solid var(--ink)}
.grid.ro b{pointer-events:none}
.seal{display:flex;flex-direction:column;gap:14px}
.out{font:.75rem/1.4 ui-monospace,Menlo,monospace;word-break:break-all;max-height:110px;overflow:auto;background:var(--paper);border:1px solid var(--line);border-radius:10px;padding:10px;user-select:all}
.capsule{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:20px}
.capsule .to{font:italic 400 2rem/1.1 var(--display)}
.capsule .from{font:600 1.35rem/1 var(--hand);color:var(--accent)}
.capsule .text{font:600 1.45rem/32px var(--hand);white-space:pre-wrap;overflow-wrap:anywhere}
.capsule .items{display:flex;gap:24px;flex-wrap:wrap;align-items:center}
.capsule img{width:150px;max-width:100%;filter:drop-shadow(0 0 0 #fff) drop-shadow(1px 1px 0 #fff) drop-shadow(-1px -1px 0 #fff) drop-shadow(0 3px 6px #0003);transform:rotate(-4deg)}
.capsule .grid.stitch{max-width:200px}
.toast{font-size:.875rem;color:var(--thread);min-height:1.3em}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}